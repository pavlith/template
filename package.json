{
  "name": "wails-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "ast-grep": "ast-grep scan",
    "knip": "knip",
    "jscpd": "jscpd",
    "test": "vitest",
    "test:run": "vitest run",
    "check:all": "pnpm format:check && pnpm lint && pnpm check && pnpm ast-grep && pnpm knip && pnpm jscpd && pnpm test:run && pnpm go:fmt && pnpm go:vet && pnpm go:test",
    "release": "node scripts/prepare-release.js",
    "bindings": "pnpm wails generate bindings -ts -i -d bindings",
    "desktop:dev": "pnpm wails dev --host 127.0.0.1 --port 1420",
    "desktop:build": "pnpm wails build",
    "go:fmt": "node scripts/check-go-format.js",
    "go:vet": "go vet ./...",
    "go:test": "go test ./...",
    "wails": "node scripts/wails.js"
  },
  "dependencies": {
    "@wailsio/runtime": "3.2.0-nightly.20261123",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "i18next": "^25.7.3",
    "paneforge": "^1.0.2",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.1.1",
    "csstype": "^3.2.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "jscpd": "^5.0.12",
    "jsdom": "^29.0.1",
    "knip": "^6.27.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
